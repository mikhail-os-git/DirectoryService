<Project>

  <!-- Central Package Management: версии всех NuGet-пакетов только здесь.
       В .csproj пишется <PackageReference Include="..." /> БЕЗ Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Версии отсюда действуют и на транзитивные пакеты
         (нужно, чтобы прижать SSH.NET из Testcontainers). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Анализаторы: подключаются ко ВСЕМ проектам автоматически. -->
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>

  <!-- ===== Microsoft: одна версия на всё семейство (идёт вместе с .NET) ===== -->

  <!-- Microsoft.Extensions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <!-- EF Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!-- У Npgsql своя нумерация, мажорная версия совпадает с EF Core -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- ===== Сторонние пакеты ===== -->

  <!-- Общие -->
  <ItemGroup>
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- 7.0.0 — новая мажорная, обновить отдельным шагом -->
    <PackageVersion Include="Scrutor" Version="6.1.0" />
  </ItemGroup>

  <!-- Swagger: 10.x обязательно, иначе конфликт с OpenApi 10 -->
  <ItemGroup>
    <PackageVersion Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <!-- Serilog -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Exceptions.EntityFrameworkCore" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <!-- Тесты -->
  <ItemGroup>
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- Новые мажорные версии есть, обновить отдельным шагом:
         coverlet.collector 10.x, Microsoft.NET.Test.Sdk 18.x, xunit.runner.visualstudio 4.x -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Транзитивные: прижаты из-за уязвимостей -->
  <ItemGroup>
    <!-- Приходит через Testcontainers. 2025.1.0 — уязвимость (NU1903). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Свои пакеты (раскомментируешь, когда переключишь Directory Service на NuGet) -->
  <!--
  <ItemGroup>
    <PackageVersion Include="MikhailOs.SharedKernel" Version="0.1.0" />
  </ItemGroup>
  -->

</Project>